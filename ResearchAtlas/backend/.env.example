# ResearchAtlas Configuration

# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True

# LLM Provider: "ollama" | "gemini" | "openai" | "mock"
LLM_PROVIDER=ollama

# Ollama Settings (Local & Free)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Cloud API Keys (Optional - only needed if LLM_PROVIDER is set to gemini/openai)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Retrieval Settings
MAX_CANDIDATE_PAPERS=25
TOP_SYNTHESIS_PAPERS=10

# Cross-Encoder Model (SentenceTransformers)
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage
DATABASE_PATH=research_atlas.db
