{
  "name": "ai-poster-studio",
  "version": "0.1.0",
  "private": true,
  "description": "I gave an AI agent a 19-page research paper and asked for one slide.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @aips/web dev",
    "dev:all": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rm -rf node_modules .next dist .turbo && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.6.3"
  }
}